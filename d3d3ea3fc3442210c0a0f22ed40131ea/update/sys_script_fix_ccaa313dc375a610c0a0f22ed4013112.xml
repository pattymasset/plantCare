    <sys_script_fix action="INSERT_OR_UPDATE">
        <before>false</before>
        <description/>
        <name>closeRejectedREQ</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[var apprGR = new GlideRecord('sysapproval_approver');
apprGR.addQuery('state', 'rejected');
apprGR.addQuery('assigned_to', 'akem');
apprGR.query();

while (apprGR.next()) {
    var reqGR = new GlideRecord('sc_req_item');
    reqGR.get(apprGR.sys_id);
    reqGR.setValue('state', 'closed_incomplete');
    reqGR.setValue('stage', 'completed');
    reqGR.setWorkflow(false);
    reqGR.update();
}]]></script>
